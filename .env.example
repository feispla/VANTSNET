# Base de datos (SQLite en desarrollo; PostgreSQL en producción)
DATABASE_URL=file:../db/custom.db

# ── Riot Games API (opcional) ────────────────────────────────────────────────
# Sin clave solo está disponible el modo demo (jugador Demo#VANTS).
# Consigue una clave de desarrollo en https://developer.riotgames.com
# Nota: las claves de desarrollo caducan cada 24 h y NO incluyen los datos de
# partidas de Valorant (VAL-MATCH-V1) — ver docs/SOLICITUD-CLAVE-PRODUCCION.md
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# ── Steam Web API (opcional) ─────────────────────────────────────────────────
# Habilita GET /api/steam/resolve (perfiles y biblioteca pública de Steam).
# Clave gratuita: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=0000000000000000000000000000000000000000
