# ─── VANTSNET — variables de entorno ─────────────────────────────────────────
# Copia este archivo a .env y rellena solo lo que necesites.
# NUNCA subas un .env real a Git (está excluido por .gitignore).

# Base de datos (OBLIGATORIA) — PostgreSQL via Prisma ORM 8
# Desde la migración a Prisma 8 ya no se usa SQLite: la base de datos es
# PostgreSQL (Prisma Postgres, Neon o cualquier PostgreSQL accesible).
#
# Prisma Postgres (plataforma Prisma): la URL la da el despliegue o
#   console.prisma.io — formato: postgres://...@db.prisma.io:5432/postgres?sslmode=require
# Neon (free tier):       postgresql://usuario:contraseña@ep-xxx.neon.tech/vantsnet?sslmode=require
# PostgreSQL local:       postgresql://postgres:postgres@localhost:5432/vantsnet
#
# Comandos (ver docs/DATABASE.md):
#   bun run db:emit     -> regenera contract.json tras editar el contrato
#   bun run db:update   -> aplica el contrato a la BD de desarrollo
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vantsnet"

# ─── Claves de APIs de juegos (secretas — solo servidor) ──────────────────────
# Riot Games: https://developer.riotgames.com — verifica Riot IDs reales.
# Nota: VAL-MATCH-V1 requiere clave de producción (docs/SOLICITUD-CLAVE-PRODUCCION.md)
RIOT_API_KEY=""

# Steam Web API (gratuita): https://steamcommunity.com/dev/apikey — habilita /api/steam/resolve
STEAM_API_KEY=""

# ─── Plataforma competitiva ───────────────────────────────────────────────────
# Token de operaciones de administración (X-Admin-Token en mutaciones).
# Genera uno largo y aleatorio:  openssl rand -hex 32
ADMIN_TOKEN=""

# ─── Discord OAuth2 (identity, scope identify) ────────────────────────────────
# 1) https://discord.com/developers/applications → New Application → OAuth2
# 2) Redirect URI: https://TU-DOMINIO/api/auth/discord/callback
# 3) El state OAuth se firma con DISCORD_OAUTH_STATE_SECRET (openssl rand -hex 32)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_OAUTH_STATE_SECRET=""
# Opcional: fija la redirect URI en lugar de derivarla del origen de la petición
DISCORD_REDIRECT_URI=""

# ─── FACEIT Data API v4 (server key) ────────────────────────────────────────
# https://developers.faceit.com → crea una app → Server-side key
FACEIT_API_KEY=""

feat/vants-bus
# ─── VANTS-BUS (bus de eventos del ecosistema — opcional) ────────────────────
# Cliente en src/lib/bus/vants-bus.ts. Si falta cualquiera de las dos
# variables el bus queda apagado y el resto de la API funciona igual.
#   VANTS_BUS_URL:    https://vants-bus.vants.workers.dev
#   VANTS_BUS_SECRET: secreto HMAC del proyecto "vantsnet" (lo reparte
#                     quien administra el Worker vants-bus; nunca en el
#                     código del navegador)

# ─── VANTS-BUS (bus de eventos del ecosistema) ────────────────────────────────
# Sin estas dos variables la publicación queda apagada y la API funciona igual.
# VANTS_BUS_URL es la URL pública del bus (https://vants-bus.vants.workers.dev);
# VANTS_BUS_SECRET es el secreto HMAC del proyecto "vantsnet" en el bus.
# El secreto SOLO del lado servidor; nunca en el bundle del navegador.
 main
VANTS_BUS_URL=""
VANTS_BUS_SECRET=""
